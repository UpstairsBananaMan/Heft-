# Copy into apps/mobile/.env and apps/admin/.env.local after `supabase start`.
# `supabase status` prints the API URL and anon key. Never commit real secrets.

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin (Next.js) — same Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge functions only. Local `supabase start` injects SUPABASE_* automatically.
# Set Stripe secrets with `supabase secrets set` for deployed functions.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
