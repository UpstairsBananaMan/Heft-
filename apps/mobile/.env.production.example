# Hosted Supabase. Copy to apps/mobile/.env on a release machine, or set the same
# names as EAS environment variables. Do not commit filled-in values.
# Project URL looks like https://YOUR_PROJECT_REF.supabase.co
# Anon key is the public key from Project Settings → API. It is still not a file to commit.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_ADMIN_URL=https://YOUR_ADMIN_HOST
EXPO_PUBLIC_EAS_PROJECT_ID=
