{
  "name": "heft",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@heft/mobile",
    "admin": "npm run dev --workspace=@heft/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@heft/shared",
    "demo": "node scripts/demo.mjs",
    "demo:admin": "NEXT_PUBLIC_DEMO_MODE=1 npm run dev --workspace=@heft/admin",
    "demo:mobile": "EXPO_PUBLIC_DEMO_MODE=1 npm run web --workspace=@heft/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
